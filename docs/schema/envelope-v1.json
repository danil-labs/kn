{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kn application envelope 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "status",
    "data",
    "conflicts",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "conflict",
        "unsupported"
      ]
    },
    "data": {},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "suggested_next_action"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "suggested_next_action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
